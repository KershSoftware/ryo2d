// The Meshes page's banner: a flag on a pole, drawn for the demo (see
// README.md), written by hand but for the ripple's keys.
//
// The flag is a mesh on one bone: its vertices are not weighted, and no
// bone moves. The ripple is a deform: each key gives every vertex an
// offset from where the mesh has it, and the flag is drawn between one
// key's shape and the next.
//
// Units are the art's pixels: the pole stands 640 tall, so the demo draws
// its entity at half size. The origin is the pole's foot, on the ground.
// Angles are degrees, clockwise.
(
  images: { "banner": "banner.png" },

  // Where each part is in the image, as README.md's packing command puts them
  regions: {
    "flag": (image: "banner", rect: (8, 8, 296, 176)),
    // Drawn lying down, its foot on the left
    "pole": (image: "banner", rect: (8, 192, 640, 20)),
  },

  // The pole's bone runs up it. The flag's is at the flag's top corner on
  // the pole, turned back so its x runs along the flag and its y down it.
  // It has no length: it only says where the flag is, and the overlay
  // draws it as a ring, clear of the flag's outline
  bones: [
    (name: "root"),
    (name: "pole", parent: "root", rotation: -90, length: 640),
    (name: "flag", parent: "pole", x: 600, y: -4, rotation: 90),
  ],

  // The pole is drawn over the flag's edge
  slots: [
    (name: "flag", bone: "flag", attachment: "flag"),
    (name: "pole", bone: "pole", attachment: "pole"),
  ],

  skins: {
    "default": {
      // 27 vertices, nine along the flag by three down it, 37 apart along
      // and 88 down, in 32 triangles. `vertices` are places in the flag
      // bone's space, and `uvs` the same places in the image (0 to 1
      // across the region), the two in one order: round the outline first,
      // from the top corner on the pole (the 20 that `hull` counts: along
      // the top, down the fly, back along the bottom, up the pole), then
      // the seven along the middle
      "flag": {
        "flag": Mesh(
          region: "flag",
          uvs: [
            (0, 0), (0.125, 0), (0.25, 0), (0.375, 0), (0.5, 0), (0.625, 0), (0.75, 0), (0.875, 0), (1, 0),
            (1, 0.5), (1, 1),
            (0.875, 1), (0.75, 1), (0.625, 1), (0.5, 1), (0.375, 1), (0.25, 1), (0.125, 1), (0, 1),
            (0, 0.5),
            (0.125, 0.5), (0.25, 0.5), (0.375, 0.5), (0.5, 0.5), (0.625, 0.5), (0.75, 0.5), (0.875, 0.5),
          ],
          triangles: [
            0, 1, 20, 0, 20, 19, 1, 2, 21, 1, 21, 20, 2, 3, 22, 2, 22, 21, 3, 4, 23, 3, 23, 22,
            4, 5, 24, 4, 24, 23, 5, 6, 25, 5, 25, 24, 6, 7, 26, 6, 26, 25, 7, 8, 9, 7, 9, 26,
            19, 20, 17, 19, 17, 18, 20, 21, 16, 20, 16, 17, 21, 22, 15, 21, 15, 16, 22, 23, 14, 22, 14, 15,
            23, 24, 13, 23, 13, 14, 24, 25, 12, 24, 12, 13, 25, 26, 11, 25, 11, 12, 26, 9, 10, 26, 10, 11,
          ],
          hull: 20,
          vertices: Unweighted([
            (0, 0), (37, 0), (74, 0), (111, 0), (148, 0), (185, 0), (222, 0), (259, 0), (296, 0),
            (296, 88), (296, 176),
            (259, 176), (222, 176), (185, 176), (148, 176), (111, 176), (74, 176), (37, 176), (0, 176),
            (0, 88),
            (37, 88), (74, 88), (111, 88), (148, 88), (185, 88), (222, 88), (259, 88),
          ]),
        ),
      },
      // The image's length along the bone, its middle half way up
      "pole": { "pole": Region(region: "pole", x: 320) },
    },
  },

  animations: {
    // A wave runs along the flag from the pole to the fly once a loop. A
    // key is an x and a y for each of the 27 vertices, in the mesh's
    // order, added to the vertex's place. The wave is 10 columns long, and
    // grows from nothing at the pole to 16 at the fly; each row is half a
    // radian behind the row above it, and a vertex goes round a flat
    // ellipse, 0.3 as wide as it is tall. Twelve keys a loop, and the
    // thirteenth is the first again, so the loop has no jump. README.md
    // has the program that writes the keys
    "ripple": (
      duration: 1.6,
      slots: {
        "flag": (deform: {
          "flag": [
            (0.0, [0, 0, 0.5, -1.2, 0.4, -3.8, -0.6, -5.7, -1.9, -4.7, -3, 0, -2.9, 7.1, -1.3, 13.3, 1.5, 15.2, 3.5, 11, 4.6, 4.1, 2.7, 10.8, 0.2, 12, -1.6, 8.4, -2.2, 2.9, -1.7, -1.5, -0.8, -3.1, 0, -2, 0, 0, 0, 0, 0.3, -1.8, -0.2, -3.9, -1.3, -4.1, -2.4, -1, -2.6, 4.8, -1.5, 10.8, 0.8, 13.8]),
            (0.1333, [0, 0, 0.6, -0.2, 0.9, -2.7, 0.4, -5.9, -1, -7.3, -2.6, -5, -3.6, 1.3, -3.1, 9.4, -1, 15.7, 1.4, 15.3, 3.4, 11.3, 0.7, 13.8, -1.6, 10.7, -2.7, 4.6, -2.4, -1.2, -1.3, -4.2, -0.2, -3.9, 0.3, -1.8, 0, 0, 0, 0, 0.5, -1.1, 0.4, -3.8, -0.5, -5.7, -1.9, -4.9, -3, -0.2, -3, 6.8, -1.4, 13.2]),
            (0.2667, [0, 0, 0.5, 0.8, 1.2, -0.8, 1.2, -4.5, 0.3, -8, -1.5, -8.7, -3.3, -4.9, -4.1, 2.9, -3.2, 11.9, -1.1, 15.6, 1.3, 15.4, -1.5, 13.1, -3, 6.6, -3, -0.5, -1.9, -5, -0.5, -5.8, 0.4, -3.7, 0.5, -1.1, 0, 0, 0, 0, 0.6, -0.2, 0.9, -2.6, 0.4, -5.8, -0.9, -7.4, -2.6, -5.2, -3.6, 1, -3.2, 9.1]),
            (0.4, [0, 0, 0.4, 1.6, 1.1, 1.2, 1.7, -1.9, 1.4, -6.5, 0, -10, -2.1, -9.7, -4, -4.3, -4.6, 4.9, -3.3, 11.6, -1.2, 15.5, -3.3, 8.9, -3.6, 0.7, -2.5, -5.4, -0.9, -7.5, 0.5, -5.8, 0.9, -2.5, 0.6, -0.1, 0, 0, 0, 0, 0.5, 0.9, 1.2, -0.7, 1.2, -4.4, 0.3, -7.9, -1.4, -8.8, -3.3, -5.1, -4.1, 2.6]),
            (0.5333, [0, 0, 0.1, 2, 0.8, 3, 1.8, 1.2, 2.2, -3.3, 1.5, -8.7, -0.4, -11.9, -2.8, -10.4, -4.7, -3.3, -4.6, 4.6, -3.4, 11.4, -4.1, 2.3, -3.2, -5.4, -1.4, -8.9, 0.4, -7.9, 1.3, -4.3, 1.2, -0.6, 0.5, 0.9, 0, 0, 0, 0, 0.3, 1.6, 1.1, 1.3, 1.7, -1.7, 1.5, -6.4, 0.1, -10, -2, -9.9, -4, -4.6]),
            (0.6667, [0, 0, -0.2, 1.8, 0.2, 3.9, 1.3, 4, 2.4, 0.8, 2.6, -5, 1.5, -11, -0.9, -13.7, -3.6, -10.7, -4.7, -3.7, -4.6, 4.2, -3.9, -4.9, -2, -10, 0.1, -10, 1.5, -6.2, 1.7, -1.6, 1.1, 1.4, 0.3, 1.7, 0, 0, 0, 0, 0, 2, 0.8, 3, 1.8, 1.4, 2.2, -3.1, 1.6, -8.5, -0.3, -12, -2.7, -10.6]),
            (0.8, [0, 0, -0.5, 1.2, -0.4, 3.8, 0.6, 5.7, 1.9, 4.7, 3, 0, 2.9, -7.1, 1.3, -13.3, -1.5, -15.2, -3.5, -11, -4.6, -4.1, -2.7, -10.8, -0.2, -12, 1.6, -8.4, 2.2, -2.9, 1.7, 1.5, 0.8, 3.1, 0, 2, 0, 0, 0, 0, -0.3, 1.8, 0.2, 3.9, 1.3, 4.1, 2.4, 1, 2.6, -4.8, 1.5, -10.8, -0.8, -13.8]),
            (0.9333, [0, 0, -0.6, 0.2, -0.9, 2.7, -0.4, 5.9, 1, 7.3, 2.6, 5, 3.6, -1.3, 3.1, -9.4, 1, -15.7, -1.4, -15.3, -3.4, -11.3, -0.7, -13.8, 1.6, -10.7, 2.7, -4.6, 2.4, 1.2, 1.3, 4.2, 0.2, 3.9, -0.3, 1.8, 0, 0, 0, 0, -0.5, 1.1, -0.4, 3.8, 0.5, 5.7, 1.9, 4.9, 3, 0.2, 3, -6.8, 1.4, -13.2]),
            (1.0667, [0, 0, -0.5, -0.8, -1.2, 0.8, -1.2, 4.5, -0.3, 8, 1.5, 8.7, 3.3, 4.9, 4.1, -2.9, 3.2, -11.9, 1.1, -15.6, -1.3, -15.4, 1.5, -13.1, 3, -6.6, 3, 0.5, 1.9, 5, 0.5, 5.8, -0.4, 3.7, -0.5, 1.1, 0, 0, 0, 0, -0.6, 0.2, -0.9, 2.6, -0.4, 5.8, 0.9, 7.4, 2.6, 5.2, 3.6, -1, 3.2, -9.1]),
            (1.2, [0, 0, -0.4, -1.6, -1.1, -1.2, -1.7, 1.9, -1.4, 6.5, 0, 10, 2.1, 9.7, 4, 4.3, 4.6, -4.9, 3.3, -11.6, 1.2, -15.5, 3.3, -8.9, 3.6, -0.7, 2.5, 5.4, 0.9, 7.5, -0.5, 5.8, -0.9, 2.5, -0.6, 0.1, 0, 0, 0, 0, -0.5, -0.9, -1.2, 0.7, -1.2, 4.4, -0.3, 7.9, 1.4, 8.8, 3.3, 5.1, 4.1, -2.6]),
            (1.3333, [0, 0, -0.1, -2, -0.8, -3, -1.8, -1.2, -2.2, 3.3, -1.5, 8.7, 0.4, 11.9, 2.8, 10.4, 4.7, 3.3, 4.6, -4.6, 3.4, -11.4, 4.1, -2.3, 3.2, 5.4, 1.4, 8.9, -0.4, 7.9, -1.3, 4.3, -1.2, 0.6, -0.5, -0.9, 0, 0, 0, 0, -0.3, -1.6, -1.1, -1.3, -1.7, 1.7, -1.5, 6.4, -0.1, 10, 2, 9.9, 4, 4.6]),
            (1.4667, [0, 0, 0.2, -1.8, -0.2, -3.9, -1.3, -4, -2.4, -0.8, -2.6, 5, -1.5, 11, 0.9, 13.7, 3.6, 10.7, 4.7, 3.7, 4.6, -4.2, 3.9, 4.9, 2, 10, -0.1, 10, -1.5, 6.2, -1.7, 1.6, -1.1, -1.4, -0.3, -1.7, 0, 0, 0, 0, 0, -2, -0.8, -3, -1.8, -1.4, -2.2, 3.1, -1.6, 8.5, 0.3, 12, 2.7, 10.6]),
            (1.6, [0, 0, 0.5, -1.2, 0.4, -3.8, -0.6, -5.7, -1.9, -4.7, -3, 0, -2.9, 7.1, -1.3, 13.3, 1.5, 15.2, 3.5, 11, 4.6, 4.1, 2.7, 10.8, 0.2, 12, -1.6, 8.4, -2.2, 2.9, -1.7, -1.5, -0.8, -3.1, 0, -2, 0, 0, 0, 0, 0.3, -1.8, -0.2, -3.9, -1.3, -4.1, -2.4, -1, -2.6, 4.8, -1.5, 10.8, 0.8, 13.8]),
          ],
        }),
      },
    ),
  },
)
