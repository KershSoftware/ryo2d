// The demo's mix. The engine loads it at start: the standard buses, a bus
// for each row of the voice limits page, two snapshots and a duck
(
  buses: {
    "sfx/prevent": (),
    "sfx/oldest": (),
    "sfx/quietest": (),
    "sfx/farthest": (),
    // The priority row's three sounds share this bus and its limit
    "sfx/priority": (limit: 3),
  },
  snapshots: {
    // As under a pause menu: the game muffled behind it
    "muffled": (blend: 0.5, buses: {
      "music": (volume: -6.0, low_pass: 700.0),
      "sfx": (low_pass: 900.0),
      "ambience": (volume: -6.0, low_pass: 600.0),
    }),
    // A quiet moment: the beds pulled down
    "quiet": (blend: 1.0, buses: {
      "music": (volume: -18.0),
      "ambience": (volume: -15.0),
    }),
  },
  // A voice line dips the music
  ducks: [(trigger: "voice", target: "music", by: -12.0, attack: 0.15, release: 0.6)],
)
