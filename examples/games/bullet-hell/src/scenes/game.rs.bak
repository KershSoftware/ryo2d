//! Main game scene with all gameplay logic

use crate::components::*;
use crate::save::save_best_time;
use crate::*;
use rand::Rng;
use ryo2d::prelude::*;

pub struct GameScene {
  player: Option<Entity>,
  turrets: Vec<Entity>,
  bullets: Vec<Entity>,
  particles: Vec<Entity>,
  platforms: Vec<Entity>,
  survival_time: f32,
  player_sprite: Option<SpriteHandle>,
  turret_sprite: Option<SpriteHandle>,
  bullet_sprite: Option<SpriteHandle>,
  particle_sprite: Option<SpriteHandle>,
  platform_sprite: Option<SpriteHandle>,
}

impl GameScene {
  pub fn new() -> Self {
    Self {
      player: None,
      turrets: Vec::new(),
      bullets: Vec::new(),
      particles: Vec::new(),
      platforms: Vec::new(),
      survival_time: 0.0,
      player_sprite: None,
      turret_sprite: None,
      bullet_sprite: None,
      particle_sprite: None,
      platform_sprite: None,
    }
  }

  fn spawn_player(&mut self, ctx: &mut SceneContext) {
    let sprite = self.player_sprite.as_ref().unwrap().clone();
    let player_entity = ctx.world.spawn((
      Transform::new(SCREEN_WIDTH as f32 / 2.0, 500.0),
      Renderable::sprite(sprite).with_z_order(Z_PLAYER),
      Velocity::zero(),
      Player::new(PLAYER_MAX_LIVES),
    ));
    self.player = Some(player_entity);
  }

  fn spawn_platforms(&mut self, ctx: &mut SceneContext) {
    let sprite = self.platform_sprite.as_ref().unwrap().clone();

    // Ground platform
    let ground = ctx.world.spawn((
      Transform::new(SCREEN_WIDTH as f32 / 2.0, SCREEN_HEIGHT as f32 - 10.0),
      Renderable::sprite(sprite.clone()).with_z_order(Z_PLATFORM),
      Platform,
    ));
    self.platforms.push(ground);

    // Floating platforms
    let platform_configs = vec![
      (200.0, 450.0, 150.0), // x, y, width
      (600.0, 450.0, 150.0),
      (400.0, 350.0, 100.0),
      (150.0, 250.0, 120.0),
      (650.0, 250.0, 120.0),
      (400.0, 150.0, 100.0),
    ];

    for (x, y, width) in platform_configs {
      let mut transform = Transform::new(x, y);
      transform.scale_x = width / 100.0; // Scale from base 100px width
      let platform = ctx.world.spawn((
        transform,
        Renderable::sprite(sprite.clone()).with_z_order(Z_PLATFORM),
        Platform,
      ));
      self.platforms.push(platform);
    }
  }

  fn spawn_turrets(&mut self, ctx: &mut SceneContext) {
    let sprite = self.turret_sprite.as_ref().unwrap().clone();
    let mut rng = rand::thread_rng();

    // Left side turrets
    for _ in 0..TURRETS_PER_SIDE {
      let y = rng.gen_range(100.0..(SCREEN_HEIGHT as f32 - 100.0));
      let turret = ctx.world.spawn((
        Transform::new(TURRET_SIZE / 2.0 + 10.0, y),
        Renderable::sprite(sprite.clone()).with_z_order(Z_TURRET),
        Turret::new(TurretSide::Left),
      ));
      self.turrets.push(turret);
    }

    // Right side turrets
    for _ in 0..TURRETS_PER_SIDE {
      let y = rng.gen_range(100.0..(SCREEN_HEIGHT as f32 - 100.0));
      let turret = ctx.world.spawn((
        Transform::new(SCREEN_WIDTH as f32 - TURRET_SIZE / 2.0 - 10.0, y),
        Renderable::sprite(sprite.clone()).with_z_order(Z_TURRET),
        Turret::new(TurretSide::Right),
      ));
      self.turrets.push(turret);
    }
  }

  fn update_player(&mut self, ctx: &mut SceneContext, dt: f32) {
    let Some(player_entity) = self.player else {
      return;
    };

    let Ok((transform, velocity, player)) = ctx
      .world
      .query_one_mut::<(&mut Transform, &mut Velocity, &mut Player)>(player_entity)
    else {
      return;
    };

    // Update player state
    player.update(dt);

    // Horizontal movement
    let mut move_x = 0.0;
    if ctx.input.key_pressed(KeyCode::KeyA) || ctx.input.key_pressed(KeyCode::ArrowLeft) {
      move_x -= 1.0;
    }
    if ctx.input.key_pressed(KeyCode::KeyD) || ctx.input.key_pressed(KeyCode::ArrowRight) {
      move_x += 1.0;
    }
    velocity.x = move_x * PLAYER_SPEED;

    // Jumping
    if (ctx.input.key_just_pressed(KeyCode::Space) || ctx.input.key_just_pressed(KeyCode::KeyW))
      && player.is_grounded
    {
      velocity.y = -PLAYER_JUMP_FORCE;
      player.is_grounded = false;
    }

    // Apply gravity
    velocity.y += GRAVITY * dt;

    // Apply velocity
    transform.x += velocity.x * dt;
    transform.y += velocity.y * dt;

    // Screen bounds
    let half_size = PLAYER_SIZE / 2.0;
    transform.x = transform
      .x
      .clamp(half_size, SCREEN_WIDTH as f32 - half_size);

    // Ground collision (simple)
    if transform.y >= SCREEN_HEIGHT as f32 - half_size {
      transform.y = SCREEN_HEIGHT as f32 - half_size;
      velocity.y = 0.0;
      player.is_grounded = true;
    }

    // Check platform collisions
    self.check_player_platform_collision(ctx);

    // Check if dead
    if !player.is_alive() {
      self.game_over(ctx);
    }
  }

  fn check_player_platform_collision(&mut self, ctx: &mut SceneContext) {
    let Some(player_entity) = self.player else {
      return;
    };

    let Ok((player_transform, player_velocity, player)) =
      ctx
        .world
        .query_one_mut::<(&mut Transform, &mut Velocity, &mut Player)>(player_entity)
    else {
      return;
    };

    let player_half = PLAYER_SIZE / 2.0;
    let player_bottom = player_transform.y + player_half;
    let player_top = player_transform.y - player_half;
    let player_left = player_transform.x - player_half;
    let player_right = player_transform.x + player_half;

    for &platform_entity in &self.platforms {
      let Ok(platform_transform) = ctx.world.query_one_mut::<&Transform>(platform_entity) else {
        continue;
      };

      let platform_width = 100.0 * platform_transform.scale_x;
      let platform_half_width = platform_width / 2.0;
      let platform_half_height = PLATFORM_THICKNESS / 2.0;

      let platform_left = platform_transform.x - platform_half_width;
      let platform_right = platform_transform.x + platform_half_width;
      let platform_top = platform_transform.y - platform_half_height;
      let platform_bottom = platform_transform.y + platform_half_height;

      // Check AABB collision
      if player_right > platform_left
        && player_left < platform_right
        && player_bottom > platform_top
        && player_top < platform_bottom
      {
        // Landing on top of platform
        if player_velocity.y > 0.0 && player_bottom <= platform_top + 10.0 {
          player_transform.y = platform_top - player_half;
          player_velocity.y = 0.0;
          player.is_grounded = true;
        }
      }
    }
  }

  fn update_turrets(&mut self, ctx: &mut SceneContext, dt: f32) {
    for &turret_entity in &self.turrets {
      let Ok((transform, turret)) = ctx
        .world
        .query_one_mut::<(&mut Transform, &mut Turret)>(turret_entity)
      else {
        continue;
      };

      // Move up and down
      transform.y += turret.move_direction * TURRET_MOVE_SPEED * dt;

      // Bounce off screen edges
      let margin = TURRET_SIZE;
      if transform.y < margin || transform.y > SCREEN_HEIGHT as f32 - margin {
        turret.reverse_direction();
        transform.y = transform.y.clamp(margin, SCREEN_HEIGHT as f32 - margin);
      }

      // Shooting logic
      if turret.burst_count > 0 {
        turret.burst_timer -= dt;
        if turret.burst_timer <= 0.0 {
          self.shoot_bullet(ctx, transform.x, transform.y, turret.side);
          turret.burst_count -= 1;
          turret.burst_timer = TURRET_BURST_DELAY;
        }
      } else {
        turret.shoot_timer -= dt;
        if turret.shoot_timer <= 0.0 {
          turret.burst_count = TURRET_BURST_SIZE;
          turret.burst_timer = TURRET_BURST_DELAY;
          turret.shoot_timer = TURRET_SHOOT_INTERVAL;
        }
      }
    }
  }

  fn shoot_bullet(&mut self, ctx: &mut SceneContext, x: f32, y: f32, side: TurretSide) {
    let Some(player_entity) = self.player else {
      return;
    };

    let Ok(player_transform) = ctx.world.query_one_mut::<&Transform>(player_entity) else {
      return;
    };

    // Calculate direction to player with some randomness
    let mut rng = rand::thread_rng();
    let target_x = player_transform.x + rng.gen_range(-30.0..30.0);
    let target_y = player_transform.y + rng.gen_range(-30.0..30.0);

    let dx = target_x - x;
    let dy = target_y - y;
    let length = (dx * dx + dy * dy).sqrt();

    let velocity = if length > 0.0 {
      Vector2::new(dx / length * BULLET_SPEED, dy / length * BULLET_SPEED)
    } else {
      let direction = match side {
        TurretSide::Left => 1.0,
        TurretSide::Right => -1.0,
      };
      Vector2::new(direction * BULLET_SPEED, 0.0)
    };

    let sprite = self.bullet_sprite.as_ref().unwrap().clone();
    let bullet = ctx.world.spawn((
      Transform::new(x, y),
      Renderable::sprite(sprite).with_z_order(Z_BULLET),
      Bullet::new(velocity),
    ));
    self.bullets.push(bullet);
  }

  fn update_bullets(&mut self, ctx: &mut SceneContext, dt: f32) {
    let mut bullets_to_remove = Vec::new();

    for (i, &bullet_entity) in self.bullets.iter().enumerate() {
      let Ok((transform, bullet)) = ctx
        .world
        .query_one_mut::<(&mut Transform, &Bullet)>(bullet_entity)
      else {
        bullets_to_remove.push(i);
        continue;
      };

      // Move bullet
      transform.x += bullet.velocity.x * dt;
      transform.y += bullet.velocity.y * dt;

      // Check if out of bounds
      if transform.x < -50.0
        || transform.x > SCREEN_WIDTH as f32 + 50.0
        || transform.y < -50.0
        || transform.y > SCREEN_HEIGHT as f32 + 50.0
      {
        bullets_to_remove.push(i);
        ctx.world.despawn(bullet_entity).ok();
        continue;
      }

      // Check collision with player
      if self.check_bullet_player_collision(ctx, transform.x, transform.y) {
        self.create_explosion(ctx, transform.x, transform.y);
        bullets_to_remove.push(i);
        ctx.world.despawn(bullet_entity).ok();
        continue;
      }

      // Check collision with platforms
      if self.check_bullet_platform_collision(ctx, transform.x, transform.y) {
        self.create_explosion(ctx, transform.x, transform.y);
        bullets_to_remove.push(i);
        ctx.world.despawn(bullet_entity).ok();
      }
    }

    // Remove bullets in reverse order to maintain indices
    for i in bullets_to_remove.iter().rev() {
      self.bullets.swap_remove(*i);
    }
  }

  fn check_bullet_player_collision(&mut self, ctx: &mut SceneContext, bx: f32, by: f32) -> bool {
    let Some(player_entity) = self.player else {
      return false;
    };

    let Ok((player_transform, player)) = ctx
      .world
      .query_one_mut::<(&Transform, &mut Player)>(player_entity)
    else {
      return false;
    };

    let dx = bx - player_transform.x;
    let dy = by - player_transform.y;
    let dist_sq = dx * dx + dy * dy;
    let collision_dist = (PLAYER_SIZE + BULLET_SIZE) / 2.0;

    if dist_sq < collision_dist * collision_dist {
      player.take_damage();
      return true;
    }

    false
  }

  fn check_bullet_platform_collision(&self, ctx: &mut SceneContext, bx: f32, by: f32) -> bool {
    let bullet_half = BULLET_SIZE / 2.0;

    for &platform_entity in &self.platforms {
      let Ok(platform_transform) = ctx.world.query_one_mut::<&Transform>(platform_entity) else {
        continue;
      };

      let platform_width = 100.0 * platform_transform.scale_x;
      let platform_half_width = platform_width / 2.0;
      let platform_half_height = PLATFORM_THICKNESS / 2.0;

      let platform_left = platform_transform.x - platform_half_width;
      let platform_right = platform_transform.x + platform_half_width;
      let platform_top = platform_transform.y - platform_half_height;
      let platform_bottom = platform_transform.y + platform_half_height;

      if bx + bullet_half > platform_left
        && bx - bullet_half < platform_right
        && by + bullet_half > platform_top
        && by - bullet_half < platform_bottom
      {
        return true;
      }
    }

    false
  }

  fn create_explosion(&mut self, ctx: &mut SceneContext, x: f32, y: f32) {
    let mut rng = rand::thread_rng();
    let sprite = self.particle_sprite.as_ref().unwrap().clone();

    for _ in 0..PARTICLES_PER_EXPLOSION {
      let angle = rng.gen_range(0.0..std::f32::consts::TAU);
      let speed = rng.gen_range(PARTICLE_SPEED_MIN..PARTICLE_SPEED_MAX);
      let velocity = Vector2::new(angle.cos() * speed, angle.sin() * speed);

      let particle_entity = ctx.world.spawn((
        Transform::new(x, y),
        Renderable::sprite(sprite.clone()).with_z_order(Z_PARTICLE),
        Particle::new(velocity, PARTICLE_LIFETIME),
      ));
      self.particles.push(particle_entity);
    }
  }

  fn update_particles(&mut self, ctx: &mut SceneContext, dt: f32) {
    let mut particles_to_remove = Vec::new();

    for (i, &particle_entity) in self.particles.iter().enumerate() {
      let Ok((transform, renderable, particle)) =
        ctx
          .world
          .query_one_mut::<(&mut Transform, &mut Renderable, &mut Particle)>(particle_entity)
      else {
        particles_to_remove.push(i);
        continue;
      };

      // Update lifetime
      particle.lifetime -= dt;
      if !particle.is_alive() {
        particles_to_remove.push(i);
        ctx.world.despawn(particle_entity).ok();
        continue;
      }

      // Move particle
      transform.x += particle.velocity.x * dt;
      transform.y += particle.velocity.y * dt;

      // Fade out based on lifetime
      let alpha = (particle.alpha() * 255.0) as u8;
      if let Some(sprite) = &mut renderable.sprite {
        sprite.tint.a = alpha;
      }
    }

    // Remove particles in reverse order
    for i in particles_to_remove.iter().rev() {
      self.particles.swap_remove(*i);
    }
  }

  fn game_over(&mut self, ctx: &mut SceneContext) {
    // Save best time
    save_best_time(self.survival_time);

    // Pass survival time to game over scene
    ctx
      .scene_data
      .insert("survival_time".to_string(), Box::new(self.survival_time));

    ctx.switch_scene("game_over");
  }
}

impl Scene for GameScene {
  fn on_enter(&mut self, ctx: &mut SceneContext) {
    // Reset state
    self.survival_time = 0.0;

    // Clear all entities
    if let Some(player) = self.player.take() {
      ctx.world.despawn(player).ok();
    }
    for turret in self.turrets.drain(..) {
      ctx.world.despawn(turret).ok();
    }
    for bullet in self.bullets.drain(..) {
      ctx.world.despawn(bullet).ok();
    }
    for particle in self.particles.drain(..) {
      ctx.world.despawn(particle).ok();
    }
    for platform in self.platforms.drain(..) {
      ctx.world.despawn(platform).ok();
    }

    // Load sprites
    let player_sprite = Sprite::load("assets/player.png").expect("Failed to load player sprite");
    let turret_sprite = Sprite::load("assets/turret.png").expect("Failed to load turret sprite");
    let bullet_sprite = Sprite::load("assets/bullet.png").expect("Failed to load bullet sprite");
    let particle_sprite =
      Sprite::load("assets/particle.png").expect("Failed to load particle sprite");
    let platform_sprite =
      Sprite::load("assets/platform.png").expect("Failed to load platform sprite");

    self.player_sprite = Some(SpriteHandle::from_sprite(player_sprite, "player.png"));
    self.turret_sprite = Some(SpriteHandle::from_sprite(turret_sprite, "turret.png"));
    self.bullet_sprite = Some(SpriteHandle::from_sprite(bullet_sprite, "bullet.png"));
    self.particle_sprite = Some(SpriteHandle::from_sprite(particle_sprite, "particle.png"));
    self.platform_sprite = Some(SpriteHandle::from_sprite(platform_sprite, "platform.png"));

    // Spawn game entities
    self.spawn_platforms(ctx);
    self.spawn_turrets(ctx);
    self.spawn_player(ctx);
  }

  fn update(&mut self, ctx: &mut SceneContext, dt: f32) {
    self.survival_time += dt;

    self.update_player(ctx, dt);
    self.update_turrets(ctx, dt);
    self.update_bullets(ctx, dt);
    self.update_particles(ctx, dt);

    // ESC to return to menu
    if ctx.input.key_just_pressed(KeyCode::Escape) {
      ctx.switch_scene("menu");
    }
  }

  fn render(&mut self, ctx: &mut SceneContext) {
    let ui = ctx.ui.immediate();

    // Clear to dark blue background
    ui.clear(Color::rgb(15, 15, 25));

    // Render UI
    let Some(player_entity) = self.player else {
      return;
    };

    let Ok(player) = ctx.world.query_one_mut::<&Player>(player_entity) else {
      return;
    };

    // Lives
    let lives_text = format!("Lives: {}", player.lives);
    ui.draw_text(&lives_text, 10, 10, Color::rgb(255, 100, 100));

    // Survival time
    let time_text = format!("Time: {:.1}s", self.survival_time);
    ui.draw_text(&time_text, 10, 35, Color::rgb(100, 255, 100));

    // Entity counts (for debugging GPU batching)
    let bullet_count = self.bullets.len();
    let particle_count = self.particles.len();
    let total = bullet_count + particle_count;
    let counts_text = format!(
      "Bullets: {}  Particles: {}  Total: {}",
      bullet_count, particle_count, total
    );
    ui.draw_text(&counts_text, 10, 60, Color::rgb(150, 150, 200));

    // Invincibility indicator
    if player.invincible_timer > 0.0 {
      let inv_text = "INVINCIBLE";
      let (inv_w, _) = ui.text_size(inv_text);
      ui.draw_text(
        inv_text,
        (SCREEN_WIDTH as f32 / 2.0 - inv_w as f32 / 2.0) as i32,
        100,
        Color::rgb(255, 215, 0),
      );
    }
  }
}
